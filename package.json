{
  "name": "token-diet-mcp",
  "version": "1.0.0",
  "description": "🍃 MCP server that reduces AI token consumption by 40-90% while preserving output quality. Works with Claude, Codex, Copilot, Cursor, Antigravity.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "token-optimization",
    "llm",
    "ai",
    "claude",
    "copilot",
    "cursor",
    "codex",
    "antigravity",
    "markdown",
    "html-to-markdown",
    "code-compression",
    "token-reduction"
  ],
  "author": "zendy199x",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "token-diet-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cheerio": "^1.0.0",
    "diff": "^7.0.0",
    "gpt-tokenizer": "^2.8.1",
    "turndown": "^7.2.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.15.17",
    "@types/turndown": "^5.0.5",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zendy199x/token-diet-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zendy199x/token-diet-mcp/issues"
  },
  "homepage": "https://github.com/zendy199x/token-diet-mcp#readme"
}
